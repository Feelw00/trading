.env
.env.*
!.env.example
secrets/
*.key
*.pem
*.p12
*.pfx
# 증권사/인증 토큰·세션 캐시
.tokens/
*.token
.kis_token*
.op/
# 트레이딩 전용 openclaw 런타임(OPENCLAW_HOME) — bootstrap가 생성(상태·자격증명 포함)
.runtime/
# 전종목 시세 DB(대량·재생성 가능) — SQLite
data/

