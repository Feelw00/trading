# =============================================================================
# .env.example — 환경변수 템플릿 (값 없음, 커밋 대상)
# =============================================================================
# 사용법:
#   1) cp .env.example .env
#   2) 1Password "stock / .env" 항목에서 실제 값을 받아 채운다 (docs/SECRETS.md)
#   3) .env 는 .gitignore 처리됨 — 절대 커밋 금지
#
# 규칙(CLAUDE.md): 비밀값·모델명은 코드/로그/픽스처에 하드코딩 금지, 전부 여기서 주입.
# 스펙 미확정 소스는 docs/OPEN_QUESTIONS.md 참조 — 추측 구현 금지.

# --- LLM ---
# GPT-5.5 (R2 정형화, R3 페르소나) — 스키마 강제 출력
OPENAI_API_KEY=
OPENAI_MODEL=                 # 예: gpt-5.5 (하드코딩 금지, 여기서 주입)
# Claude Code headless (R4/R5/R7) — `claude -p`.
# 로컬 Claude Code 인증을 쓰면 키 불필요. 별도 키 주입 시에만 설정.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=                 # 예: claude-opus-4-8

# --- 데이터 소스 (R0 수집) — 소스 확정: docs/OPEN_QUESTIONS.md COLLECT-2 ---
# DART OpenAPI (공시) — https://opendart.fss.or.kr
DART_API_KEY=
# 한국은행 ECOS (금리·환율) — https://ecos.bok.or.kr/api  (무료, 상업가능)
ECOS_API_KEY=
# 공공데이터포털 금융위(지수/주식시세)·KRX상장종목 — https://www.data.go.kr  (무료, EOD)
DATA_GO_KR_API_KEY=
# KRX OPEN API (상장종목·시세 통계) — https://openapi.krx.co.kr  (무료, 10k콜/일·비상업)
KRX_API_KEY=
# FRED (해외지수 SOX·S&P·NASDAQ, 유가 WTI·Brent) — https://fred.stlouisfed.org/docs/api  (무료)
FRED_API_KEY=

# --- 뉴스 (COLLECT-4: 뉴스 한정 웹서치 허용) ---
# 네이버 검색 API(국내 후보 촉매) — https://developers.naver.com/apps  (무료 2.5만콜/일)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# SearXNG 셀프호스트(해외 매크로·테마) — format=json 활성 인스턴스 URL (예: http://localhost:8888)
SEARXNG_URL=

# --- 증권사 KIS (국내 종목 실시간 시세·호가 / 청산 자동화는 Phase 4) ---
# 한국투자증권 KIS Developers. 시장가 영구 비활성 — 지정가·청산(조건부)만.
# migusdn/KIS_MCP_Server MCP env 명명과 정합(COLLECT-2).
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_TYPE=             # REAL | VIRTUAL(모의)
KIS_CANO=                     # 계좌번호 앞 8자리
KIS_ACNT_PRDT_CD=01           # 계좌상품코드(기본 01)
KIS_ENABLE_TRADING=false      # 수집 단계 주문 비활성(안전 기본값)

# --- 알림 (P0/P1/P2) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 데이터베이스 (PostgreSQL, append-only) ---
# docker-compose 로컬 기본값. 운영 값은 1Password.
DATABASE_URL=postgresql://stock:CHANGE_ME@localhost:5432/stock
POSTGRES_USER=stock
POSTGRES_PASSWORD=
POSTGRES_DB=stock
