# =============================================================================
# .env.example — 환경변수 템플릿 (값 없음, 커밋 대상)
# =============================================================================
# 사용법:
#   1) cp .env.example .env
#   2) 1Password "stock / .env" 항목에서 실제 값을 받아 채운다 (docs/SECRETS.md)
#   3) .env 는 .gitignore 처리됨 — 절대 커밋 금지
#
# 규칙(CLAUDE.md): 비밀값·모델명은 코드/로그/픽스처에 하드코딩 금지, 전부 여기서 주입.
# 스펙 미확정 소스는 docs/OPEN_QUESTIONS.md 참조 — 추측 구현 금지.
# ❄️ 2026-08-26 v0.3 피벗(PIVOT-1): EXEC_*·R4_*·REGIME_*·KIS_ENABLE_TRADING 등 스윙 계열
#    변수는 동결 — v0.3 정책 파라미터로 재편 전까지 값을 채워도 소비자가 없다.

# --- LLM ---
# ❌ OpenAI API 키 경로 폐기(운영자 확정 2026-08-27, v0.3 §2) — 소비 코드 없음.
#    OpenAI는 아래 OPENCLAW_TRIGGER_MODEL의 ChatGPT 구독 OAuth로만 사용(서빙 전용).
OPENAI_API_KEY=               # 비워둘 것
OPENAI_MODEL=                 # 비워둘 것
# Claude Code headless (R4/R5/R7) — `claude -p`.
# 로컬 Claude Code 인증을 쓰면 키 불필요. 별도 키 주입 시에만 설정.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=                 # 예: claude-opus-4-8
CLAUDE_TIMEOUT_S=             # claude -p 호출 타임아웃 초 (기본 300)
SECTOR_LLM_MODEL=             # P-2 섹터 폴백 분류 모델 (미설정 시 R2_MODEL → CLAUDE_MODEL 순 폴백)
# openclaw 트리거 턴 모델 (cron exec 디스패치 전용 — 데이터·판단 미개입, 절대금지 #2).
# ChatGPT 구독 인증 사용: openclaw models auth login --provider openai --method oauth
# (API 키 불필요). 2026-07-11: 로컬 ollama 폐기로 ollama/qwen2.5:3b 에서 교체.
OPENCLAW_TRIGGER_MODEL=       # 예: openai/gpt-5.5

# R4 적대검증 선별 임계 (분포 기반 튜닝 knob — 미설정 시 코드 기본값)
R4_STRENGTH_THRESHOLD=        # single_stock 검증 임계 (기본 0.4 — 2026-06-10 분포 캘리브레이션)
R4_HIGH_STRENGTH=             # scope 무관 검증 임계 (기본 0.6 — 동일)
R4_MIN_SURVIVED=              # 3렌즈 중 confirmed 최소 생존 수 (기본 2)
R4_MAX_EVENTS=                # 선별 상한, 비용 가드 (기본 20)

# --- 데이터 소스 (R0 수집) — 소스 확정: docs/OPEN_QUESTIONS.md COLLECT-2 ---
# DART OpenAPI (공시) — https://opendart.fss.or.kr
DART_API_KEY=
# 한국은행 ECOS (금리·환율) — https://ecos.bok.or.kr/api  (무료, 상업가능)
ECOS_API_KEY=
# 공공데이터포털 금융위(지수/주식시세)·KRX상장종목 — https://www.data.go.kr  (무료, EOD)
DATA_GO_KR_API_KEY=
# KRX OPEN API (상장종목·시세 통계) — https://openapi.krx.co.kr  (무료, 10k콜/일·비상업)
KRX_API_KEY=
# FRED (해외지수 SOX·S&P·NASDAQ, 유가 WTI·Brent) — https://fred.stlouisfed.org/docs/api  (무료)
FRED_API_KEY=

# --- 뉴스 (COLLECT-4: 뉴스 한정 웹서치 허용) ---
# 네이버 검색 API(국내 후보 촉매) — https://developers.naver.com/apps  (무료 2.5만콜/일)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# SearXNG 셀프호스트(해외 매크로·테마) — format=json 활성 인스턴스 URL (예: http://localhost:8888)
SEARXNG_URL=

# --- 증권사 KIS (v0.3: 투자자매매동향(수급) 조회 전용 — 계좌·주문은 토스) ---
# 한국투자증권 KIS Developers. 필요한 것은 KEY·SECRET 둘뿐.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_TYPE=             # REAL(실전, 기본) | VTS(모의) — 서버 도메인 선택. 실전 키면 생략 가능
KIS_CANO=                     # ❄️ 미소비(v0.2 계좌 TR 예약 유산) — 비워둘 것
KIS_ACNT_PRDT_CD=             # ❄️ 미소비 — 비워둘 것
KIS_ENABLE_TRADING=           # ❄️ 미소비(구 KIS MCP 정합용) — 비워둘 것

# --- 증권사 토스 (자동 집행 EXEC-1 — 주문은 지정가·조건부 청산만, 시장가 코드 부재) ---
# 토스증권 Open API. WTS 설정 > Open API에서 발급 + 허용 IP 등록 필수(미등록 403).
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=             # GET /api/v1/accounts의 accountSeq (주문 헤더용)

# --- 자동 집행 (EXEC-1, 운영자 결정 2026-07-13 · 2차 개정: 투자 정책 캡 제거) ---
# 모드: off | dry-run(기본 — 주문 직전까지 실행, 전송 안 함) | live(실주문).
# live 전환은 dry-run 5거래일 검증 후 운영자가 직접. 긴급 정지: .runtime/exec/KILL 파일 생성.
EXEC_MODE=dry-run
# 사이징: 계좌가 상한(하드캡 없음). 예산 = 가용액 × R5 cap 계수 × 즉시 트랜치 비중, 최소 1주 보장.
EXEC_ACCOUNT_KRW=             # 계좌 고정 예치금(기본 5000000) — live는 실 매수가능금액과 대체
EXEC_MAX_NEW_PER_DAY=         # 일일 신규 상한(기본 5) — 투자 정책이 아니라 폭주 가드
EXEC_MAX_PRICE_KRW=           # 주당 가격 상한(기본 2000000) — 계단 청산 불가 종목 배제(EXEC-4)

# --- 가이드 매도 예약 (EXEC-12, 운영자 결정 2026-09-02) ---
# 실계좌 보유 × 가이드 다음 매도선 → 조건주문(SINGLE·SELL·지정가) 매일 08:40 재등록. 매수는 수동.
# 모드: off | dry-run(기본 — 조회·계획·저널만) | live(실등록). 킬 스위치는 EXEC와 공유(.runtime/exec/KILL).
# live 전환은 dry-run 5거래일 후 운영자가 직접 + 게이트웨이 재기동(.env 스냅샷).
GUIDE_ORDERS_MODE=dry-run

# --- 알림 (P0/P1/P2) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (DB 설정 없음 — PIVOT-8: SQLite 도메인별 파일 data/*.sqlite, PostgreSQL/docker 폐기)
EXEC_RR=                      # 익절 R:R 폴백(기본 1.5) — R5가 targets 미지정 시에만 사용(EXEC-2)
EXEC_MIN_RR=                  # 진입 최소 잔여 R:R(기본 1.0) — 익절 근접 진입 차단(7/14 운영자 지적)
EXEC_TEST_ENTRY=              # D1 계측: 11시까지 발동 0이면 최적 초안 1주 dry-run 관통(임시, 검증 후 제거)
REGIME_CAUTION_PCT=           # 레짐 경계 임계(기본 -3.0) — 코스피 당일 등락%, 배분 절반
REGIME_RISKOFF_PCT=           # 레짐 중단 임계(기본 -5.0) — 신규 진입 중단
