{
  "meta": {
    "lastTouchedVersion": "2026.6.11"
  },
  "agents": {
    "defaults": {
      "model": "${OPENCLAW_TRIGGER_MODEL}",
      "workspace": "${TRADING_OPENCLAW_WORKSPACE}",
      "compaction": {
        "mode": "safeguard"
      },
      "maxConcurrent": 2,
      "subagents": {
        "maxConcurrent": 4
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": false
    }
  },
  "gateway": {
    "mode": "local",
    "port": 18790,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "plugins": {
    "allow": [],
    "entries": {
      "openai": {
        "enabled": true
      },
      "codex": {
        "enabled": false
      },
      "telegram": {
        "enabled": false
      }
    }
  },
  "diagnostics": {
    "stuckSessionWarnMs": 150000
  }
}
